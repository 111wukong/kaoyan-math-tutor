/* 我的页
 *
 * 顶部是一张「个人状态卡」：头像 + 名字 + 等级 + 三个数字。
 * 下面按「用量 / 提醒 / 账号」分组，每组一张卡 —— 分组的边界
 * 比一条分割线清楚，用户不用读文字就知道哪几项是一类的。
 */

/* ---------- 个人卡 ---------- */
.profile {
  padding: 34rpx 32rpx 30rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

/* 头像：实色琥珀底 + 深字，和登录页的品牌块同一套。
 *
 * ★ 原来是「琥珀 28% → 纸白 30% 的渐变底 + 纸白字」——
 *   纸白字压在纸白底的渐变上，对比度低到几乎看不见。
 *   渐变本身也没必要：104rpx 的方块上看不出过渡，只是把底色搅浑。 */
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  flex-shrink: 0;
}

.avatar-initial {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--on-accent);
}

.who {
  flex: 1;
  min-width: 0;
}

.who-name {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--fg);
  line-height: 1.3;
}

.who-mail {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--fg-mute);
  word-break: break-all;
}

.lv {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(233, 230, 223, 0.14);
  border: 1rpx solid rgba(233, 230, 223, 0.28);
}

.lv-num {
  font-size: 24rpx;
  font-weight: 600;
  color: #e9e6df;
  font-variant-numeric: tabular-nums;
}

.lv-title {
  margin-top: 22rpx;
  font-size: 25rpx;
  color: var(--fg-soft);
}

/* 三格统计。用 app.wxss 的 .stats / .stat，只覆盖上间距 */
.profile .stats {
  margin-top: 28rpx;
}

/* ---------- 进度条过热 ---------- */
.bar-fill-hot {
  background: var(--danger);
}

/* ---------- 页脚 ---------- */
.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--fg-mute);
  opacity: 0.6;
  letter-spacing: 1rpx;
}

/* ---------- 拍照工具 ----------
 * 列表而不是三列图标。理由见 wxml 里的注释：
 * 三个方块并排时放不下说明，而「拍照录题」和「拍照解题」差在哪
 * 正是用户最先要弄清的事。
 *
 * 图标去掉了圆角方底 —— 那是「小图标块 + 标题」的通用 AI 模板
 * （impeccable 的 icon-tile-stack）。现在图标直接落在行首，
 * 靠大小和颜色和正文区分。 */
.tool-list {
  margin-top: 8rpx;
}

.tool-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--hairline);
}

.tool-row:first-child {
  border-top: none;
}

/* 图标：40rpx 的方框，只放一个形状。没有底色，没有描边。 */
.tool-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.tool-check {
  width: 26rpx;
  height: 13rpx;
  /* 三个入口是同级操作，图标统一用中性色。原来对勾是琥珀、
   * 其余是灰 —— 同一个列表里两种颜色，读起来像「有一个是禁用的」。 */
  border-left: 4rpx solid var(--fg-soft);
  border-bottom: 4rpx solid var(--fg-soft);
  transform: rotate(-45deg) translate(3rpx, -3rpx);
  border-radius: 1rpx;
}

.tool-cross-h {
  width: 26rpx;
  height: 4rpx;
  background: var(--fg-soft);
  border-radius: 2rpx;
}

.tool-cross-v {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 4rpx;
  height: 26rpx;
  background: var(--fg-soft);
  border-radius: 2rpx;
}

.tool-note-line {
  width: 30rpx;
  height: 3rpx;
  background: var(--fg-soft);
  border-radius: 2rpx;
}

.tool-body {
  flex: 1;
  min-width: 0;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--fg);
}

.tool-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--fg-mute);
  line-height: 1.5;
}

/* ============================================================
   近两周趋势
   ============================================================ */

/* 14 根柱子，不加日期标签 —— 375 宽下每根只有 18px，
 * 十四个日期会挤成一团。这一块要表达的是形状（在往上还是往下），
 * 不是精确读数；具体数字在标题里。 */
.trend {
  display: flex;
  gap: 6rpx;
  align-items: flex-end;
  height: 116rpx;
  margin-top: 22rpx;
}

.trend-col {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
}

.trend-bar {
  width: 100%;
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  background: rgba(255, 255, 255, 0.06);
  transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.trend-on {
  background: rgba(201, 151, 63, 0.68);
}

/* 今天那根满饱和，其余半透明 —— 让「我在哪儿」一眼可见 */
.trend-today {
  background: var(--accent);
}
