/* 我的页
 *
 * 顶部是一张「个人状态卡」：头像 + 名字 + 等级 + 三个数字。
 * 下面按「用量 / 提醒 / 账号」分组，每组一张卡 —— 分组的边界
 * 比一条分割线清楚，用户不用读文字就知道哪几项是一类的。
 */

/* ---------- 个人卡 ---------- */
.profile {
  padding: 34rpx 32rpx 30rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

/* 头像：渐变底 + 内圈描边。
   不做成圆形照片，因为小程序拿不到微信头像（需要用户主动授权），
   用首字 + 渐变反而更稳定、更统一。 */
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(201, 151, 63, 0.28) 0%, rgba(233, 230, 223, 0.30) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  flex-shrink: 0;
}

.avatar-initial {
  font-size: 46rpx;
  font-weight: 600;
  color: #e9e6df;
}

.who {
  flex: 1;
  min-width: 0;
}

.who-name {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--fg);
  line-height: 1.3;
}

.who-mail {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--fg-mute);
  word-break: break-all;
}

.lv {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(233, 230, 223, 0.14);
  border: 1rpx solid rgba(233, 230, 223, 0.28);
}

.lv-num {
  font-size: 24rpx;
  font-weight: 600;
  color: #e9e6df;
  font-variant-numeric: tabular-nums;
}

.lv-title {
  margin-top: 22rpx;
  font-size: 25rpx;
  color: var(--fg-soft);
}

/* 三格统计。用 app.wxss 的 .stats / .stat，只覆盖上间距 */
.profile .stats {
  margin-top: 28rpx;
}

/* ---------- 进度条过热 ---------- */
.bar-fill-hot {
  background: var(--danger);
}

/* ---------- 页脚 ---------- */
.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--fg-mute);
  opacity: 0.6;
  letter-spacing: 1rpx;
}

/* ---------- 拍照工具 ----------
 * 列表而不是三列图标。理由见 wxml 里的注释：
 * 三个方块并排时放不下说明，而「拍照录题」和「拍照解题」差在哪
 * 正是用户最先要弄清的事。
 *
 * 图标去掉了圆角方底 —— 那是「小图标块 + 标题」的通用 AI 模板
 * （impeccable 的 icon-tile-stack）。现在图标直接落在行首，
 * 靠大小和颜色和正文区分。 */
.tool-list {
  margin-top: 8rpx;
}

.tool-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--hairline);
}

.tool-row:first-child {
  border-top: none;
}

/* 图标：40rpx 的方框，只放一个形状。没有底色，没有描边。 */
.tool-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.tool-check {
  width: 26rpx;
  height: 13rpx;
  /* 三个入口是同级操作，图标统一用中性色。原来对勾是琥珀、
   * 其余是灰 —— 同一个列表里两种颜色，读起来像「有一个是禁用的」。 */
  border-left: 4rpx solid var(--fg-soft);
  border-bottom: 4rpx solid var(--fg-soft);
  transform: rotate(-45deg) translate(3rpx, -3rpx);
  border-radius: 1rpx;
}

.tool-cross-h {
  width: 26rpx;
  height: 4rpx;
  background: var(--fg-soft);
  border-radius: 2rpx;
}

.tool-cross-v {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 4rpx;
  height: 26rpx;
  background: var(--fg-soft);
  border-radius: 2rpx;
}

.tool-note-line {
  width: 30rpx;
  height: 3rpx;
  background: var(--fg-soft);
  border-radius: 2rpx;
}

.tool-body {
  flex: 1;
  min-width: 0;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--fg);
}

.tool-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--fg-mute);
  line-height: 1.5;
}
