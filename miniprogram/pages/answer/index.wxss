/* 答题页
 *
 * 选项和底部操作条来自 app.wxss（题库页也在用），这里只写这一屏独有的：
 * 计时器、判断题按钮、输入框、判定条、评分点。
 */

.answer {
  /* 给底部固定操作条让位，否则最后一段解析会被盖住 */
  padding-bottom: 300rpx;
}

/* ---------- 连续练习进度条 ---------- */
.prog-line {
  position: relative;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 3rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent-light));
  border-radius: 3rpx;
  transition: width 0.35s ease;
}

.prog-text {
  position: absolute;
  right: 0;
  top: -28rpx;
  font-size: 20rpx;
  color: var(--fg-mute);
}

/* ---------- 顶栏 ---------- */
.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 4rpx 24rpx;
}

.timer {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 48rpx;
  padding: 0 20rpx 0 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid var(--hairline);
}

/* 计时小圆点：呼吸式闪烁，提示「在计时」。
   1.6s 的周期 —— 太快会抢注意力，太慢看不出在动。 */
.timer-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.35; transform: scale(0.78); }
}

.timer-text {
  font-size: 23rpx;
  color: var(--fg-soft);
  font-variant-numeric: tabular-nums;
}

/* ---------- 判断题 ---------- */
.judge {
  display: flex;
  gap: 20rpx;
}

.judge-btn {
  flex: 1;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--fg-soft);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--hairline);
  transition: all 0.15s ease;
}

.judge-on {
  color: #a7f3e6;
  background: rgba(94, 234, 212, 0.12);
  border-color: rgba(94, 234, 212, 0.42);
}

/* ---------- 输入 ---------- */
/* 输入框的 placeholder 在深色底上默认是浅灰，几乎看不见，
   必须显式给颜色。这条在小程序里没有全局变量可用。 */
.input {
  margin-top: 20rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--hairline);
  color: var(--fg);
  font-size: 30rpx;
}

.input-placeholder {
  color: var(--fg-mute);
}

.textarea {
  margin-top: 20rpx;
  width: 100%;
  min-height: 260rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--hairline);
  color: var(--fg);
  font-size: 30rpx;
  line-height: 1.7;
}

/* ---------- 判定条 ---------- */
.verdict {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.v-ok {
  background: rgba(52, 211, 153, 0.10);
  border: 1rpx solid rgba(52, 211, 153, 0.30);
}

.v-bad {
  background: rgba(248, 113, 113, 0.10);
  border: 1rpx solid rgba(248, 113, 113, 0.30);
}

/* 判定符号：一个大字符，不用图标。
   ✓ / ✕ 在系统字体里字形清晰，而且能跟着颜色走。 */
.verdict-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.v-ok .verdict-mark {
  color: #6ee7b7;
  background: rgba(52, 211, 153, 0.18);
}

.v-bad .verdict-mark {
  color: #fca5a5;
  background: rgba(248, 113, 113, 0.18);
}

.verdict-body {
  min-width: 0;
}

.verdict-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--fg);
}

.verdict-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--fg-soft);
}

/* ---------- 解答题自评提示 ---------- */
.self-hint {
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #fde68a;
  background: rgba(251, 191, 36, 0.09);
  border: 1rpx solid rgba(251, 191, 36, 0.24);
}

/* ---------- 我的作答 ---------- */
.my-answer {
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--fg-soft);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------- 自评按钮 ---------- */
.self-row {
  display: flex;
  gap: 20rpx;
}

.self-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.self-ok {
  color: #04211d;
  background: linear-gradient(135deg, #5eead4 0%, #2dd4bf 100%);
  box-shadow: 0 12rpx 32rpx -12rpx rgba(94, 234, 212, 0.55);
}

.self-bad {
  color: #fca5a5;
  background: rgba(248, 113, 113, 0.12);
  border: 1rpx solid rgba(248, 113, 113, 0.32);
}
