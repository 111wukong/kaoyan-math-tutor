/* 答题页
 *
 * 选项和底部操作条来自 app.wxss（题库页也在用），这里只写这一屏独有的：
 * 计时器、判断题按钮、输入框、判定条、评分点。
 */

.answer {
  /* 给底部固定操作条让位，否则最后一段解析会被盖住 */
  padding-bottom: 300rpx;
}

/* ---------- 连续练习进度条 ---------- */
.prog-line {
  position: relative;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 3rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  /* ★ 这里原来写的是 linear-gradient(90deg, var(--accent), var(--accent-light))，
   *   但 --accent-light 在换色板后**不存在了** —— 未定义的变量会让整条
   *   background 声明失效，进度条会变成透明，看起来像「进度丢了」。
   *   10rpx 高的条上渐变本来也看不出来，直接纯色。 */
  background: var(--accent);
  border-radius: 3rpx;
  transition: width 0.35s ease;
}

.prog-text {
  position: absolute;
  right: 0;
  top: -28rpx;
  font-size: 20rpx;
  color: var(--fg-mute);
}

/* ---------- 顶栏 ---------- */
.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 4rpx 24rpx;
}

.timer {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 48rpx;
  padding: 0 20rpx 0 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid var(--hairline);
}

/* 计时小圆点：静态。
 * 原来它是 1.6s 一次的呼吸闪烁，用来「提示在计时」。
 * 但旁边的数字本来就在走（0 秒 → 1 秒 → 2 秒），一个会呼吸的点
 * 提供不了任何新信息，只是在抢注意力 —— 而用户在答题时需要把注意力
 * 全放在题上。impeccable 的 pulsing-dot 规则说的就是这类装饰性脉冲：
 * 把脉冲留给真正在变化的状态，静态标记 + 清晰的标签更诚实也更安静。 */
.timer-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent);
}

.timer-text {
  font-size: 23rpx;
  color: var(--fg-soft);
  font-variant-numeric: tabular-nums;
}

/* ---------- 判断题 ---------- */
.judge {
  display: flex;
  gap: 20rpx;
}

.judge-btn {
  flex: 1;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--fg-soft);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--hairline);
  transition: all 0.15s ease;
}

.judge-on {
  color: #d9a441;
  background: rgba(201, 151, 63, 0.12);
  border-color: rgba(201, 151, 63, 0.42);
}

/* ---------- 输入 ---------- */
/* 输入框的 placeholder 在深色底上默认是浅灰，几乎看不见，
   必须显式给颜色。这条在小程序里没有全局变量可用。 */
.input {
  margin-top: 20rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--hairline);
  color: var(--fg);
  font-size: 30rpx;
}

.input-placeholder {
  color: var(--fg-mute);
}

.textarea {
  margin-top: 20rpx;
  width: 100%;
  min-height: 260rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--hairline);
  color: var(--fg);
  font-size: 30rpx;
  line-height: 1.7;
}

/* ---------- 判定条 ---------- */
.verdict {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.v-ok {
  background: rgba(127, 158, 107, 0.10);
  border: 1rpx solid rgba(127, 158, 107, 0.30);
}

.v-bad {
  background: rgba(212, 104, 94, 0.10);
  border: 1rpx solid rgba(212, 104, 94, 0.30);
}

/* 判定符号：一个大字符，不用图标。
   ✓ / ✕ 在系统字体里字形清晰，而且能跟着颜色走。 */
.verdict-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.v-ok .verdict-mark {
  color: #7f9e6b;
  background: rgba(127, 158, 107, 0.18);
}

.v-bad .verdict-mark {
  color: #d4685e;
  background: rgba(212, 104, 94, 0.18);
}

.verdict-body {
  min-width: 0;
}

.verdict-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--fg);
}

.verdict-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--fg-soft);
}

/* ---------- 解答题自评提示 ---------- */
.self-hint {
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #d9a441;
  background: rgba(217, 164, 65, 0.09);
  border: 1rpx solid rgba(217, 164, 65, 0.24);
}

/* ---------- 我的作答 ---------- */
.my-answer {
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--fg-soft);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------- 自评按钮 ---------- */
.self-row {
  display: flex;
  gap: 20rpx;
}

.self-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.self-ok {
  color: #1a1408;
  background: var(--accent);
}

.self-bad {
  color: #d4685e;
  background: rgba(212, 104, 94, 0.12);
  border: 1rpx solid rgba(212, 104, 94, 0.32);
}
