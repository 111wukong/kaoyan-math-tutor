/* 题库页
 *
 * 就地展开的列表。折叠态只显示「序号 + 题型 + 难度 + 题干」，
 * 展开才出选项和解析 —— 折叠态的信息密度决定了能不能一眼扫过去。
 */

/* ---------- 筛选 ---------- */
/* 横向滚动而不是换行：筛选是次要操作，换行会占掉两行高度，
 * 而手机首屏的每一行都很贵。 */
.filter {
  display: flex;
  white-space: nowrap;
  margin: 0 -32rpx 24rpx;
  padding: 0 32rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 30rpx;
  margin-right: 14rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--fg-mute);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--hairline);
  transition: all 0.18s ease;
  /* scroll-view 里的子项必须禁止收缩，否则 flex 会把它们压成等宽 */
  flex-shrink: 0;
}

.filter-on {
  color: #1a1408;
  font-weight: 500;
  background: var(--accent);
  border-color: transparent;
}

/* ---------- 题目卡 ---------- */
.q-card {
  padding: 28rpx 28rpx 30rpx;
  transition: border-color 0.2s ease;
}

.q-open {
  border-color: rgba(201, 151, 63, 0.22);
}

.q-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 序号：圆形小徽标。比「1.」更有秩序感，也方便扫读定位 */
.q-idx {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  /* ★ 背景 0.06 的白叠在卡片上会到 #292b2e，弱文字在上面只有 4.2:1。
   *   题号是功能性文字（帮用户定位「我在第几题」），压到 0.04 + 提亮
   *   到 --fg-soft，对比度回到 5.3:1。 */
  color: var(--fg-soft);
  background: rgba(255, 255, 255, 0.04);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.q-type {
  flex-shrink: 0;
}

.dots {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.dot-on {
  background: var(--accent);
}

/* 展开箭头：两条边框旋转 45 度。不用图标文件 */
.q-toggle {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid var(--fg-mute);
  border-bottom: 3rpx solid var(--fg-mute);
  transform: rotate(45deg) translate(-3rpx, -3rpx);
  transition: transform 0.22s ease;
  flex-shrink: 0;
}

.q-toggle-up {
  transform: rotate(-135deg) translate(-3rpx, -3rpx);
}

.q-stem {
  margin-top: 20rpx;
}

/* 考点名：题干上方一行小字。
 * 放在题干之前而不是之后 —— 先知道「考什么」再读题，
 * 比读完题再回头对标签更顺。 */
.q-kid {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--accent);
}

/* ---------- 展开区 ---------- */
.q-more {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--hairline);
  animation: fadeIn 0.24s ease both;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}





.ans {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: rgba(201, 151, 63, 0.055);
  border: 1rpx solid rgba(201, 151, 63, 0.16);
}

.ans-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--accent);
  opacity: 0.9;
  margin-bottom: 14rpx;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.7;
}

/* 展开区里的「去做这道题」。右对齐 —— 它是个次要动作，
   不该和解析抢视觉重心。 */
.go-answer {
  margin-top: 26rpx;
  margin-left: auto;
}

/* ============================================================
   难度分布
   ============================================================ */

/* 一行小柱，紧贴筛选条下面。
 * 做得淡是故意的 —— 它是背景信息（题库长什么样），
 * 不是要用户操作的东西。列表才是这一页的主角。 */
.diff {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin: -10rpx 0 22rpx;
}

.diff-label {
  font-size: 23rpx;
  line-height: 1;
  color: var(--fg-mute);
  flex-shrink: 0;
  /* 和柱子下面那排数字对齐，不是和柱子底对齐 */
  padding-bottom: 2rpx;
}

/* 柱子固定宽度而不是 flex: 1 —— 平分整行的话每根 40px，
 * 看起来是五根横条，不像柱状图。 */
.diff-bars {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 72rpx;
}

.diff-col {
  width: 48rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.diff-bar {
  width: 100%;
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  background: rgba(201, 151, 63, 0.55);
}

.diff-v {
  font-size: 22rpx;
  line-height: 1;
  color: var(--fg-mute);
  font-variant-numeric: tabular-nums;
}
