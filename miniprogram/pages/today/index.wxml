<view class="page">

  <!-- ===== 顶部：招呼 + 日期 ===== -->
  <view class="page-head rise">
    <view class="head-row">
      <view>
        <view class="page-title">{{greeting}}</view>
        <view class="page-sub">{{dateText}}</view>
      </view>
      <view wx:if="{{streak > 0}}" class="streak">
        <view class="streak-flame"></view>
        <text class="streak-num">{{streak}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 维护 / 公告 ===== -->
  <view wx:if="{{maintenance}}" class="banner banner-warn rise">
    <text>{{maintenance.message}}</text>
  </view>

  <view wx:if="{{notice}}" class="banner {{notice.level === 'warn' ? 'banner-warn' : 'banner-info'}} rise">
    <view class="notice-dot"></view>
    <view class="notice-body">
      <text class="notice-title">{{notice.title}}</text>
      <text wx:if="{{notice.body}}" class="notice-text">{{notice.body}}</text>
    </view>
  </view>

  <!-- ===== 未登录 ===== -->
  <view wx:if="{{needLogin}}" class="card card-lit rise-1 rise">
    <view class="card-title">还没登录</view>
    <view class="card-desc">登录后才会看到你的复习队列和今日一练。</view>
    <button class="btn" style="margin-top: 32rpx" bindtap="goLogin">微信一键登录</button>
  </view>

  <block wx:else>

    <!-- ===== 主卡：待复习 =====
         两个形态。有卡时是「行动号召」，没卡时是「下一步引导」——
         新用户第一次进来 due 必然是 0（新卡的到期日是明天），
         如果这时只给一个灰色的「今天没有到期的卡片」，他看到的是
         一堵墙：既没东西可做，也不知道该做什么，很可能就此退出。
         所以零卡态必须给出一个可点的动作。 -->
    <view class="card card-hero card-lit rise-1 rise">

      <block wx:if="{{due > 0}}">
        <view class="card-row hero-top">
          <view class="hero-label">
            <text class="t-label">待复习</text>
            <text class="t-label hero-sep">·</text>
            <text class="t-label">{{levelTitle || '开始今天'}}</text>
          </view>
          <view class="pill pill-accent">{{xp}} XP</view>
        </view>

        <view class="hero-num-row">
          <view class="hero-num-main">
            <text class="t-display hero-num">{{due}}</text>
            <text class="hero-unit">张卡片到期</text>
          </view>

          <!-- 今日进度环：已做 / 应做。conic-gradient 画弧，中间挖空。
               比线性条多一层「快到了」的直觉 —— 环快合上时最明显。 -->
          <view
            class="ring"
            style="background: conic-gradient(var(--accent) 0 {{reviewPct}}%, rgba(255,255,255,0.08) {{reviewPct}}% 100%)"
          >
            <view class="ring-hole">
              <text class="ring-pct">{{reviewPct}}<text class="ring-unit">%</text></text>
              <text class="ring-cap">{{reviewDone}}/{{reviewTotal}}</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="card-row hero-top">
          <view class="hero-label">
            <text class="t-label">今天</text>
            <text class="t-label hero-sep">·</text>
            <text class="t-label">{{levelTitle || '开始今天'}}</text>
          </view>
          <view class="pill pill-accent">{{xp}} XP</view>
        </view>

        <view class="hero-empty-title">没有要复习的</view>
        <view class="hero-empty-desc">
          卡片来自你答过的题。做一道，明天它就会出现在这里。
        </view>
      </block>

      <button wx:if="{{due > 0}}" class="btn hero-btn" bindtap="goReview">开始复习</button>
      <button wx:elif="{{quiz}}" class="btn hero-btn" bindtap="startQuiz">做今日一练</button>
      <button wx:else class="btn hero-btn" bindtap="goQuiz">去题库练几道</button>
    </view>

    <!-- ===== 本周热力图 =====
         七天，每格深浅 = 当天做了多少题。
         这一块回答的是「我这周到底有没有在学」—— 一个数字回答不了，
         一串方块可以。而且它天然有形状：连续七天都亮着，本身就是奖励。 -->
    <view wx:if="{{heat.length}}" class="card rise-2 rise">
      <view class="card-row">
        <view class="card-title">本周</view>
        <view class="t-label">{{todayDone > 0 ? '今天已做 ' + todayDone + ' 题' : '今天还没开始'}}</view>
      </view>

      <view class="heat">
        <view wx:for="{{heat}}" wx:key="key" class="heat-col">
          <view class="heat-bar-wrap">
            <view
              class="heat-bar {{item.n ? 'heat-on' : ''}} {{item.today ? 'heat-today' : ''}}"
              style="height: {{item.h}}%"
            ></view>
          </view>
          <text class="heat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 三科掌握度 =====
         颜色来自考点的分类（高数蓝 / 线代绿 / 概率暖），不是随便挑的装饰色。
         服务端给的是给深色 Web 端用的暗色（#1b4d8f 在卡片上只有 2:1），
         这里映射到提亮版 —— 见 wxss 的 .cat-*。 -->
    <view wx:if="{{cats.length}}" class="card rise-2 rise">
      <view class="card-title">三科掌握</view>

      <view class="cats">
        <view wx:for="{{cats}}" wx:key="id" class="cat-row">
          <text class="cat-name">{{item.name}}</text>
          <view class="cat-track">
            <view class="cat-fill cat-{{item.id}}" style="width: {{item.pct}}%"></view>
          </view>
          <text class="cat-pct">{{item.pct}}%</text>
        </view>
      </view>
    </view>

    <!-- ===== 今日一练 ===== -->
    <view wx:if="{{quiz}}" class="card rise-2 rise">
      <view class="card-row">
        <view class="card-title">今日一练</view>
        <view class="pill pill-violet">{{quiz.typeLabel}}</view>
      </view>

      <view class="quiz-stem">
        <math-text wx:if="{{!loading}}" segments="{{quizSegs}}" />
        <view wx:else class="quiz-sk">
          <view class="skeleton" style="height: 30rpx; width: 88%"></view>
          <view class="skeleton" style="height: 30rpx; width: 62%; margin-top: 16rpx"></view>
        </view>
      </view>

      <view class="quiz-foot">
        <view class="dots">
          <view wx:for="{{quizDots}}" wx:key="i" class="dot {{item.on ? 'dot-on' : ''}}"></view>
          <text class="t-label dots-label">难度</text>
        </view>
        <button class="btn btn-ghost btn-sm" bindtap="startQuiz">去做题</button>
      </view>
    </view>

    <!-- ===== 加载骨架 ===== -->
    <view wx:if="{{loading}}" class="card rise-2 rise">
      <view class="skeleton" style="height: 30rpx; width: 34%"></view>
      <view class="skeleton" style="height: 30rpx; width: 78%; margin-top: 24rpx"></view>
    </view>

    <view wx:if="{{!loading && !quiz}}" class="empty rise-2 rise">
      今天没有安排新的练习
      <view class="empty-sub">去「题库」按考点挑一道也行</view>
    </view>

  </block>
</view>
