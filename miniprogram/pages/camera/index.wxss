/* 拍照识别页 */

.camera {
  padding-bottom: 180rpx;
}

/* ---------- 头部 ---------- */
.cam-head {
  padding: 8rpx 4rpx 28rpx;
}

.cam-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--fg);
}

.cam-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--fg-mute);
  line-height: 1.6;
}

/* ---------- 预览区 ---------- */
.preview-wrap {
  position: relative;
  width: 100%;
  height: 480rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--hairline);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}

/* 占位 */
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
  height: 100%;
}

.ph-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(94, 234, 212, 0.10);
  border: 2rpx solid rgba(94, 234, 212, 0.30);
}

.ph-cross-h {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 4rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

.ph-cross-v {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 4rpx;
  height: 32rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

.ph-text {
  font-size: 26rpx;
  color: var(--fg-mute);
}

/* 加载蒙层 */
.overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: rgba(8, 9, 15, 0.72);
  backdrop-filter: blur(4rpx);
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(94, 234, 212, 0.15);
  border-top-color: var(--accent);
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.overlay-text {
  font-size: 26rpx;
  color: var(--fg-soft);
}

/* ---------- 结果文字 ----------
 * ★ 注意：内容交给 math-text 组件渲染，它内部把字号写死成 17px
 *   （要和服务端 FONT_PX 一致，见组件的注释）。所以这里只做容器该做的事
 *   —— 间距。写 font-size 是无效的，别被它骗了。
 */
.result-body {
  margin-top: 14rpx;
}

/* ---------- 底部按钮 ---------- */
.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-row .btn {
  flex: 1;
}

/* ============================================================
   解题结果
   ============================================================ */

/* ---------- 思路 ---------- */
.approach {
  margin-top: 14rpx;
}

/* ---------- 「想好了吗？」折叠卡 ---------- */
/* 虚线边框：它在视觉上是一道「门」，不是内容本身。
   实线卡片会让人以为里面已经有东西了。 */
.reveal-card {
  border-style: dashed;
  border-color: rgba(255, 255, 255, 0.16);
  text-align: center;
  padding: 44rpx 32rpx;
}

.reveal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--fg);
}

.reveal-desc {
  margin: 14rpx 0 28rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--fg-mute);
}

/* ---------- 分步解答 ---------- */
.solve-step {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid var(--hairline);
}

.solve-step:first-of-type {
  margin-top: 20rpx;
}

/* 步骤序号：一个窄胶囊，不抢视觉但能数清到第几步 */
.solve-step-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(94, 234, 212, 0.10);
  border: 1rpx solid rgba(94, 234, 212, 0.22);
}

.solve-step-body {
  flex: 1;
  min-width: 0;
}

/* 说明和式子都交给 math-text 渲染（字号由组件定）。这里只控制层级：
   式子缩进一点、颜色淡一点 —— 它是对上一句话的补充，不是并列内容。 */
.solve-step-t {
  color: var(--fg);
}

.solve-step-f {
  margin-top: 10rpx;
  padding-left: 2rpx;
  opacity: 0.82;
}

/* ---------- 答案 ---------- */
.answer-box {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border-radius: 16rpx;
  background: rgba(94, 234, 212, 0.07);
  border: 1rpx solid rgba(94, 234, 212, 0.20);
}

.answer-label {
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--accent);
  opacity: 0.8;
}

.answer-text {
  margin-top: 8rpx;
}

/* ---------- 考点标签 ---------- */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 23rpx;
  color: var(--fg-soft);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--hairline);
}

/* ---------- 提示块 ---------- */
.hint-block {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
}

/* 易错点用暖色：它是警告，不是信息 */
.hint-warn {
  background: rgba(251, 191, 36, 0.07);
  border: 1rpx solid rgba(251, 191, 36, 0.20);
}

/* 判断信号用青色：它是方法，要记住的 */
.hint-good {
  background: rgba(94, 234, 212, 0.06);
  border: 1rpx solid rgba(94, 234, 212, 0.18);
}
