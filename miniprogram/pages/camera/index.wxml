<view class="page camera">

  <!-- ===== 标题 ===== -->
  <view class="cam-head">
    <view class="cam-title">{{title}}</view>
    <view class="cam-sub">
      {{mode === 'question' ? '拍一道题，AI 帮你识别并录入' : '拍笔记，AI 帮你整理成知识点'}}
    </view>
  </view>

  <!-- ===== 图片预览区 ===== -->
  <view class="preview-wrap">
    <block wx:if="{{phase === 'idle'}}">
      <view class="placeholder" bindtap="onTakePhoto">
        <view class="ph-icon">
          <view class="ph-cross-h"></view>
          <view class="ph-cross-v"></view>
        </view>
        <view class="ph-text">点击拍照或从相册选择</view>
      </view>
    </block>

    <block wx:if="{{phase !== 'idle'}}">
      <image class="preview-img" src="{{imagePath}}" mode="aspectFit" />
    </block>

    <!-- 加载蒙层 -->
    <view wx:if="{{phase === 'recognizing' || phase === 'extracting'}}" class="overlay">
      <view class="spinner"></view>
      <view class="overlay-text">{{phase === 'recognizing' ? '正在识别…' : '正在生成卡片…'}}</view>
    </view>
  </view>

  <!-- ===== 错误提示 ===== -->
  <view wx:if="{{error}}" class="card card-lit">
    <view class="card-title">出错了</view>
    <view class="card-desc">{{error}}</view>
  </view>

  <!-- ===== 识别结果 ===== -->
  <block wx:if="{{phase === 'result' || phase === 'extracting'}}">
    <view class="card card-lit">
      <view class="card-row">
        <view class="card-title">识别结果</view>
        <view class="pill pill-accent" wx:if="{{cards.length}}">{{cards.length}} 张卡片</view>
      </view>
      <view class="result-text">{{result}}</view>
    </view>

    <!-- 生成的卡片列表 -->
    <block wx:if="{{cards.length}}">
      <view wx:for="{{cards}}" wx:key="id" class="card rise">
        <view class="card-title">{{item.title}}</view>
        <view class="card-desc" style="margin-top:10rpx">{{item.front}}</view>
      </view>
    </block>
  </block>

  <!-- ===== 底部操作 ===== -->
  <view class="actions">
    <block wx:if="{{phase === 'idle'}}">
      <button class="btn" bindtap="onTakePhoto">拍照 / 选图</button>
    </block>

    <block wx:if="{{phase === 'preview'}}">
      <view class="btn-row">
        <button class="btn btn-ghost" bindtap="onRetake">重选</button>
        <button class="btn" bindtap="onRecognize">开始识别</button>
      </view>
    </block>

    <block wx:if="{{phase === 'result'}}">
      <view class="btn-row">
        <button class="btn btn-ghost" bindtap="onCopy">复制文字</button>
        <button wx:if="{{mode === 'question'}}" class="btn" bindtap="onExtract">生成卡片</button>
        <button class="btn btn-ghost" bindtap="onDone">完成</button>
      </view>
    </block>
  </view>

</view>
