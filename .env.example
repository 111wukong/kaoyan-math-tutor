# 研数 · 环境变量示例
#
# 复制成 .env 或直接 export 到环境里。全部都有默认值，
# 一个都不设也能跑起来 —— 但**上线前请至少设 NODE_ENV**。
#
#   cp .env.example .env
#   # 然后按需改，再 npm run start
#
# 注意：这个项目**不读 .env 文件**（没引 dotenv），
# 上面那行只是为了让你有个地方记录。实际生效方式是：
#   set -a && . ./.env && set +a && npm run start
# 或者在 systemd 的 EnvironmentFile= 里指过来。

# ── 运行 ──────────────────────────────────────────────────────────
PORT=5180
# 默认只监听本机。要对外提供服务请配反向代理，把 Node 留在 127.0.0.1；
# 实在要直接暴露，才改成 0.0.0.0。
HOST=127.0.0.1

# ★ 上线必须设成 production。
#   它只有一个作用，但是关键：cookie 的 Secure 标记。
#   不设的话 Set-Cookie 里没有 Secure，会话 token 会走明文 HTTP 发出去，
#   同一个 WiFi 下谁都能抓走 —— 然后就是 30 天的完整账号权限。
NODE_ENV=production

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 数据库路径。默认 server/data/app.db
# DB_PATH=/var/lib/yanshu/app.db

# ── 反向代理 ──────────────────────────────────────────────────────
# ★ 只有在确实跑在代理后面时才设，而且**别写 true**。
#
# 打开它意味着「相信 X-Forwarded-For」，而那个头客户端可以随便写。
# 裸奔时开着它，按 IP 计数的限流就形同虚设：每换一个头就换一个身份，
# 登录接口可以无限次试密码（实测：固定头第 13 次被限流，
# 轮换头打 16 次一次都没被拦）。
#
# 设成代理自己的地址，Fastify 认 CIDR 列表、逗号分隔：
#   TRUST_PROXY=127.0.0.1          # 代理与 Node 同机（Caddy / nginx 默认场景）
#   TRUST_PROXY=172.16.0.0/12      # 容器网络
#   TRUST_PROXY=127.0.0.1,::1      # 多个

# ── 引导管理员 ────────────────────────────────────────────────────
# 只在「库里一个管理员都没有」时生效，之后启动是纯读，不会覆盖你改过的密码。
# 两个都不设 → 邮箱用 admin@localhost，密码现场随机生成并打印一次到启动日志。
# 想自己指定：
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=换成你自己的强口令

# 管理员显示名
# ADMIN_USERNAME=管理员

# ── 注册开关 ──────────────────────────────────────────────────────
# 默认开着。对外部署时建议关掉。
#
# 开放注册意味着任何陌生人都能自己建号；而「有账号」正是「用户可自定义
# 模型上游地址」这个功能的前提 —— 两者叠在一起，服务端就变成了一个
# 可被陌生人使用的出网代理。关掉注册，暴露面从「互联网」缩到
# 「你认识的几个人」。
#
# 关掉不会把人锁在外面：库里没有管理员时，启动会按上面的 ADMIN_*
# 引导一个出来，之后账号由管理员在管理台建。
#
# ★ 只有 'false' 才算关。写 '0' / 'no' / 'off' 这种「看起来像关闭」的值，
#   实际是开着的 —— 那是最危险的一类配置误解。
# REGISTRATION_ENABLED=false

# ── 模型接入 ──────────────────────────────────────────────────────
# 用户填的 Base URL 会被服务端拿去发请求，所以有 SSRF 防护：
#   环回地址（127.0.0.1 / ::1）  → 始终放行（本地模型 LM Studio / Ollama 靠它）
#   其它私有网段                 → 默认拒绝（169.254.169.254 云元数据也在其中）
#   云端模型                     → 必须 https，否则 API Key 会明文发出去
#
# 模型跑在同一局域网的另一台机器上（比如台式机跑 Ollama、笔记本用），
# 才打开这个开关。打开等于放弃这层防护，请确认站点不是开放注册的。
# ALLOW_PRIVATE_LLM_HOST=1
