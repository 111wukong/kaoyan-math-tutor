{
  "name": "kaoyan-math-tutor",
  "version": "2.0.0",
  "private": true,
  "description": "研数 · 考研数学 AI 自学系统（全栈重构版）",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build",
    "typecheck": "npm -w web run typecheck",
    "check": "npm run typecheck && npm run build",
    "test": "node tests/run-all.mjs",
    "test:latex": "node tests/latex-coverage.mjs",
    "test:pipeline": "node tests/pipeline-leak.mjs",
    "test:graph": "node tests/graph.mjs",
    "test:api": "node server/scripts/smoke.mjs",
    "test:ratelimit": "node server/scripts/rate-limit.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:day": "node tests/day-boundary.mjs",
    "banding": "node tests/banding.mjs",
    "shots": "node tests/screenshot.mjs",
    "gallery": "node tests/theme-gallery.mjs",
    "start": "npm -w server run start",
    "seed": "npm -w server run seed",
    "edges": "npm -w server run edges",
    "backup": "npm -w server run backup"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
