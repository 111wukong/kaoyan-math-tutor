# 研数 · systemd 服务单元
#
# 用法：
#   1. sudo useradd --system --home /opt/yanshu --shell /usr/sbin/nologin yanshu
#   2. sudo mkdir -p /opt/yanshu && sudo chown yanshu:yanshu /opt/yanshu
#   3. 把仓库放到 /opt/yanshu/kaoyan-math-tutor，以 yanshu 身份跑
#      npm ci && npm run check
#   4. sudo cp deploy/yanshu.service /etc/systemd/system/
#   5. sudo systemctl daemon-reload && sudo systemctl enable --now yanshu
#   6. journalctl -u yanshu -f        # 看日志（管理员初始密码在这里）
#
# 路径按实际情况改：ExecStart 里的 node 路径用 `which node` 查，
# 用 nvm / fnm 装的话那是个带版本号的路径，升级 Node 后要同步改这里。

[Unit]
Description=研数 · 考研数学 AI 自学系统
Documentation=https://github.com/111wukong/kaoyan-math-tutor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yanshu
Group=yanshu
WorkingDirectory=/opt/yanshu/kaoyan-math-tutor

# ★ 这三个是 README 里说的「上线前必须决定的三个变量」。
#
#   为什么写在单元文件里而不是 shell profile：systemd 不读你的 .zshrc，
#   写在那边等于没设。而 NODE_ENV 没设的后果很隐蔽 ——
#   不报错、不崩，只是 cookie 少一个 Secure 标记，
#   会话 token 走明文 HTTP，同一个网络里谁都能抓走。
Environment=NODE_ENV=production
Environment=TRUST_PROXY=127.0.0.1
Environment=REGISTRATION_ENABLED=false

# 其余配置放这个文件（DB_PATH / RATE_LIMIT_MAX / ALLOW_PRIVATE_LLM_HOST …）。
# 权限 600、属主 yanshu，别提交进仓库：
#   sudo install -m 600 -o yanshu -g yanshu /dev/null /etc/yanshu.env
# 前面那个减号表示「文件不存在也不算错」，方便先起来再补配置。
EnvironmentFile=-/etc/yanshu.env

ExecStart=/usr/bin/node server/src/index.js

# 崩了自动重启，但别陷入疯狂重启 —— 起不来通常是配置问题，
# 5 秒间隔能让 journalctl 里看清原因。
Restart=on-failure
RestartSec=5s

# 服务端自己处理 SIGTERM 并 app.close()，给它时间把在途请求做完。
KillSignal=SIGTERM
TimeoutStopSec=20

# 收尾：它只需要写自己的数据目录。
# 数据库是单文件 SQLite，写不进去的后果是启动即失败（SQLITE_CANTOPEN），
# 所以这条 ReadWritePaths 是必须的，不是可选的加固。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yanshu/kaoyan-math-tutor/server/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yanshu

[Install]
WantedBy=multi-user.target
